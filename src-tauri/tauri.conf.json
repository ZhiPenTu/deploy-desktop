{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeployCabin",
  "version": "0.2.13",
  "identifier": "com.deploydesktop.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "部署舱",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "跨平台离线部署与镜像清单管理工具",
    "longDescription": "支持本地免网部署、局域网 SSH 推送、镜像仓库清单拉取与离线导出的跨平台部署助手",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ZhiPenTu/deploy-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMkNDOTU5MjFBNDVFOEIKUldTTFhxUWhXY2tzaThjQ1lKMFlxTHdzZlhPRkN3Zm5sTU5RZnNnR01JbmRUMFFaNE9VU2R5am8K",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
