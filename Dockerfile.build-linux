# ==============================================================================
# Linux 跨平台离线安装包构建镜像 (生成 .deb 与 .AppImage)
# ==============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
ENV RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup

# 换用国内高速 APT 镜像并安装 WebKitGTK 与基础依赖
RUN sed -i 's@//archive.ubuntu.com/@//mirrors.aliyun.com/@g' /etc/apt/sources.list && \
    sed -i 's@//security.ubuntu.com/@//mirrors.aliyun.com/@g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl wget file build-essential pkg-config libssl-dev \
        libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 安装 Node.js 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm config set registry https://registry.npmmirror.com

# 安装 Rust 与 Tauri CLI
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
RUN cargo install tauri-cli --version "^2.0.0" --locked

WORKDIR /app/deploy-desktop

CMD ["sh", "-c", "npm install && npm run build && cargo tauri build --bundles deb,appimage"]
