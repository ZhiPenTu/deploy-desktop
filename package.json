{
  "name": "deploy-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:ui-text": "node scripts/check-ui-text.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:api": "node --test test/*.test.mjs",
    "predev": "npm run check:ui-text",
    "dev": "vite",
    "prebuild": "npm run check:ui-text && npm run check:boundaries",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "bash scripts/dev-app.sh --launch",
    "dev:app:build": "bash scripts/dev-app.sh",
    "mcp": "node mcp-server/index.mjs",
    "test:mcp": "npm --prefix mcp-server test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "diff": "^8.0.4",
    "element-plus": "^2.14.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7",
    "@tauri-apps/cli": "^2.11.0"
  }
}
