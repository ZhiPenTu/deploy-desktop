{
  "name": "示例部署配置",
  "containerPrefix": "demo-stack",
  "bundleDir": "/opt/deploy/bundle",
  "deployDir": "/opt/deploy",
  "installDir": "/opt/deploy",
  "backendArtifact": "app-server.jar",
  "components": {
    "backend": [
      "backend"
    ],
    "gateway": [],
    "frontend": [
      "frontend"
    ]
  },
  "database": {
    "serviceKey": "database",
    "name": "demo",
    "client": "psql",
    "port": 5432
  },
  "containers": [
    {
      "serviceKey": "backend",
      "label": "后端服务",
      "port": 8000,
      "protocol": "TCP",
      "description": "示例后端服务 (8000)"
    },
    {
      "serviceKey": "frontend",
      "label": "Web 入口",
      "port": 8080,
      "protocol": "TCP",
      "description": "示例 Web 站点 (8080)"
    },
    {
      "serviceKey": "database",
      "label": "数据库",
      "port": 5432,
      "protocol": "TCP",
      "description": "示例数据库 (5432)"
    }
  ],
  "images": [
    {
      "file": "app.tar",
      "imageRef": "example/app:1.0.0"
    },
    {
      "file": "postgres.tar",
      "imageRef": "postgres:16-alpine"
    }
  ]
}
