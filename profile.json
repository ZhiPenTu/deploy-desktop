{
  "name": "默认部署配置",
  "containerPrefix": "tt-net-manager",
  "bundleDir": "/opt/deploy/bundle",
  "deployDir": "/opt/deploy",
  "installDir": "/opt/deploy",
  "backendArtifact": "tt-net-manager-server.jar",
  "database": {
    "serviceKey": "oceanbase",
    "name": "tt_net_manager",
    "client": "obclient",
    "port": 2881
  },
  "containers": [
    {
      "serviceKey": "backend-java",
      "label": "后端主节点",
      "port": 8000,
      "protocol": "TCP",
      "description": "应用主节点 (8000, Fat Jar)"
    },
    {
      "serviceKey": "backend-java-b",
      "label": "后端从节点",
      "port": 8001,
      "protocol": "TCP",
      "description": "应用从节点 (8001, Fat Jar)"
    },
    {
      "serviceKey": "frontend",
      "label": "Web 入口",
      "port": 18080,
      "protocol": "TCP",
      "description": "Web 静态站点 (18080, Nginx)"
    },
    {
      "serviceKey": "oceanbase",
      "label": "数据库",
      "port": 12881,
      "protocol": "TCP",
      "description": "关系型数据库 (12881)"
    },
    {
      "serviceKey": "redis",
      "label": "缓存",
      "port": 6390,
      "protocol": "TCP",
      "description": "缓存与会话 (6390)"
    },
    {
      "serviceKey": "kafka",
      "label": "消息队列",
      "port": 9092,
      "protocol": "TCP",
      "description": "消息队列 (9092)"
    },
    {
      "serviceKey": "udp-lb",
      "label": "UDP 负载均衡",
      "port": 20000,
      "protocol": "UDP",
      "description": "UDP 四层负载均衡 (20000/udp)"
    },
    {
      "serviceKey": "gateway-shard-1",
      "label": "网关分片 1",
      "port": null,
      "protocol": "TCP",
      "description": "设备网关 分片 1"
    },
    {
      "serviceKey": "gateway-shard-2",
      "label": "网关分片 2",
      "port": null,
      "protocol": "TCP",
      "description": "设备网关 分片 2"
    }
  ],
  "images": [
    {
      "file": "oceanbase.tar",
      "imageRef": "oceanbase/oceanbase-ce:4.4.2-lts"
    },
    {
      "file": "kafka.tar",
      "imageRef": "bitnamilegacy/kafka:4.0"
    },
    {
      "file": "redis.tar",
      "imageRef": "redis:7.2.8"
    },
    {
      "file": "openjdk.tar",
      "imageRef": "bellsoft/liberica-openjdk-rocky:21-cds"
    },
    {
      "file": "nginx.tar",
      "imageRef": "nginx:1.27-alpine"
    },
    {
      "file": "frontend.tar",
      "imageRef": "deploy-frontend:dev"
    }
  ]
}
